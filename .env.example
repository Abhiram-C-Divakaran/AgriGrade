# GEMINI_API_KEY: Required for Gemini image-analysis calls.
# In Google AI Studio, configure this in the Secrets panel.
# For local development, copy this file to .env and replace the placeholder.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: Optional local/server port. Hosting platforms such as Cloud Run inject PORT automatically.
PORT="3000"

# VITE_API_URL: Optional frontend API base URL.
# Leave blank when the frontend and Express API are served from the same origin.
# Example for a separately hosted API: VITE_API_URL="https://api.example.com"
VITE_API_URL=""

# APP_URL: Public URL where this application is hosted.
# AI Studio may inject this at runtime with the Cloud Run service URL.
APP_URL="YOUR_APP_URL"
